DJANGO_DEBUG=0
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
AUDIT_CHAIN_KEY=replace-with-an-independent-random-key-kept-outside-database-backups
PUBLIC_DOMAIN=vectorlab.example.org
DJANGO_ALLOWED_HOSTS=vectorlab.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://vectorlab.example.org
VECTORLAB_PUBLIC_BASE_URL=http://127.0.0.1:8000
POSTGRES_DB=vectorlab
POSTGRES_USER=vectorlab
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Compose supplies POSTGRES_HOST=db. For local SQLite development, leave it unset.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Use low only after checking accuracy on representative forms; medium is the tested default.
GEMINI_THINKING_LEVEL=medium
EXTRACTION_PROVIDER=gemini
# In production, cloud processing of customer/lab data is OFF until the lab
# approves the provider, data residency, retention and access terms.
CLOUD_AI_ALLOWED=0
# Separate cost safeguard; keep off until a deliberately budgeted provider run.
PAID_AI_ALLOWED=0
PDF_SIGNING_P12_PATH=
PDF_SIGNING_P12_PASSWORD=
EMAIL_DELIVERY_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Production always redirects HTTP to HTTPS. Set proxy trust only when Caddy
# removes client-supplied X-Forwarded-Proto and supplies its own value.
DJANGO_TRUST_PROXY_HTTPS=1
# Deploy only on a dedicated HTTPS domain whose subdomains are also HTTPS.
# Production sends one-year HSTS with includeSubDomains and preload.
DJANGO_HSTS_SECONDS=31536000
